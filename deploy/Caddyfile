# SITE_DOMAIN is the bare domain: vps.betgenius.ng while rehearsing,
# betgenius.ng after cutover. Caddy obtains and renews the certificates.
#
# Behind Cloudflare's proxy: set SSL/TLS to "Full (strict)" and leave
# Cloudflare's "Always Use HTTPS" OFF, so Let's Encrypt's HTTP challenge on
# port 80 reaches Caddy (Caddy redirects everything else to HTTPS itself).

{$SITE_DOMAIN} {
	encode zstd gzip
	reverse_proxy app:3000
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}
