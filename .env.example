# --- Core ---
DATABASE_URL="file:./dev.db"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"

# --- API-Football (RapidAPI) ---
# https://rapidapi.com/api-sports/api/api-football
API_FOOTBALL_KEY=""
API_FOOTBALL_HOST="v3.football.api-sports.io"

# Daily quota accounting (src/lib/football/usage.ts). Both are optional — the
# values below are the in-code defaults, matching the Pro plan's 7,500/day.
# Set LIMIT if the plan changes; set RESERVE higher to hold back more headroom
# for drift between local counts and the account's real usage.
API_FOOTBALL_DAILY_LIMIT="7500"
API_FOOTBALL_DAILY_RESERVE="100"

# --- Google Gemini for AI predictions panel ---
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"

# --- Paystack ---
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_SECRET_KEY=""
PAYSTACK_WEBHOOK_SECRET=""

# Subscription plan codes (create in Paystack dashboard, paste codes here)
PAYSTACK_PLAN_VIP=""
PAYSTACK_PLAN_PREMIUM=""

# --- Bootstrap admin ---
SEED_ADMIN_EMAIL="admin@betgenius.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"
