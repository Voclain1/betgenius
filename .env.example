# --- Core ---
DATABASE_URL="file:./dev.db"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"

# --- API-Football (RapidAPI) ---
# https://rapidapi.com/api-sports/api/api-football
API_FOOTBALL_KEY=""
API_FOOTBALL_HOST="v3.football.api-sports.io"

# Daily quota accounting (src/lib/football/usage.ts). Both are optional — the
# values below are the in-code defaults, matching the Pro plan's 7,500/day.
# Set LIMIT if the plan changes; set RESERVE higher to hold back more headroom
# for drift between local counts and the account's real usage.
API_FOOTBALL_DAILY_LIMIT="7500"
API_FOOTBALL_DAILY_RESERVE="100"

# --- AI providers for the predictions panel ---
# Gemini is the PRIMARY provider. Groq is a fallback, tried only when Gemini is
# overloaded (503 after retries), out of quota (429), or unreachable — never in
# parallel, and never load-balanced: the published track record should measure
# one model, not an average of two. See src/lib/ai/analysis.ts.
GEMINI_API_KEY=""
# MUST be an explicit, versioned model id. NEVER an alias, and NEVER empty.
#
# An alias silently repoints at a new model. That is not hypothetical here:
# "gemini-flash-latest" moved this app onto Gemini 3.7 Flash with no code change,
# altering price, latency and output shape underneath a running deployment, and
# 3.7 Flash's introductory pricing doubles on 2027-01-01.
#
# An EMPTY value is just as dangerous: it is falsy, so it falls through to
# DEFAULT_GEMINI_MODEL in src/lib/ai/providers/gemini.ts. Production was set to
# "" and therefore ran a different model from local without anyone choosing to.
#
# A model change should be a reviewed deploy, measured with
# scripts/validate-digest.ts (it reports tokens, latency and both outputs) — not
# something that happens on a Tuesday.
#
# Pinned to 3.7 Flash because every prompt measurement in this repo was taken on
# it, and because Gemini 2.5 Flash retires from 2026-10-16. Revisit before
# 2027-01-01 when introductory pricing ends, and keep MODEL_PRICES in
# src/lib/generation/stats.ts in step so the cost panel stays honest.
GEMINI_MODEL="gemini-3.7-flash"

# Fallback. Leave GROQ_API_KEY empty to disable it entirely — the chain skips
# any provider that isn't configured, so no flag is needed to turn it off.
# NOTE: Groq shut down llama-3.3-70b-versatile and llama-3.1-8b-instant on
# 2026-08-16; openai/gpt-oss-120b is their named replacement and the default here.
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

# Shared secret for the externally scheduled routes: /api/admin/settle,
# /api/admin/refresh-enrichment and /api/admin/generate/run. Sent as
# "Authorization: Bearer $CRON_SECRET" by cron-job.org — Vercel's own crons are
# capped at once per day on this plan, which is why these are scheduled
# externally (see commit 0d0e10c).
CRON_SECRET=""

# --- Paystack ---
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_SECRET_KEY=""
PAYSTACK_WEBHOOK_SECRET=""

# Subscription plan codes (create in Paystack dashboard, paste codes here)
PAYSTACK_PLAN_VIP=""
PAYSTACK_PLAN_PREMIUM=""

# --- Bootstrap admin ---
SEED_ADMIN_EMAIL="admin@betgenius.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"
