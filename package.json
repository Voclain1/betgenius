{
  "name": "betgenius",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && tsx scripts/check-schema-sync.ts && next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "check:schema": "tsx scripts/check-schema-sync.ts",
    "check:paystack-entitlement": "tsx scripts/check-paystack-entitlement.ts",
    "check:combo-bet": "tsx scripts/check-combo-bet-copy.ts",
    "check:confidence": "tsx scripts/check-confidence-consistency.ts",
    "check:feed-days": "tsx scripts/check-feed-days.ts",
    "check:brand-assets": "tsx scripts/check-brand-assets.ts",
    "check:nav-width": "tsx scripts/check-nav-width.ts",
    "check:preview-banner": "tsx scripts/check-preview-banner.ts",
    "check:kickoff-assert": "tsx scripts/check-kickoff-assert.ts",
    "preflight": "tsx scripts/check-schema-sync.ts && tsx scripts/check-paystack-entitlement.ts && tsx scripts/check-combo-bet-copy.ts && tsx scripts/check-confidence-consistency.ts && tsx scripts/check-feed-days.ts && tsx scripts/check-brand-assets.ts && tsx scripts/check-nav-width.ts && tsx scripts/check-preview-banner.ts && tsx scripts/check-kickoff-assert.ts && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@google/genai": "^2.11.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "next": "14.2.15",
    "next-auth": "^4.24.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.15",
    "postcss": "^8.4.47",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
