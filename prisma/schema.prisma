// Betgenius — data model
// Postgres (Neon). "Enum-like" fields are kept as plain strings rather than
// real Prisma enums; matching TypeScript union types live in src/lib/enums.ts.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// Role: "USER" | "ADMIN_PENDING" | "ADMIN" | "SUPER_ADMIN"
// SubscriptionTier: "FREE" | "VIP" | "PREMIUM"
// SubscriptionStatus: "PENDING" | "ACTIVE" | "CANCELED" | "EXPIRED"
// PredictionCategory: "FEATURED" | "GENIUS" | "TODAY" | "BANKER" | "VIP" | "PREMIUM"
// PredictionStatus: "DRAFT" | "PENDING_REVIEW" | "APPROVED" | "PUBLISHED" | "ARCHIVED"
// Outcome: "PENDING" | "WON" | "LOST" | "VOID"
// TaskStatus: "OPEN" | "IN_PROGRESS" | "DONE"

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  emailVerified  DateTime? // Required by PrismaAdapter's AdapterUser shape — every OAuth createUser() call includes it (null for a fresh sign-up), even though nothing here reads it back. Missing this column is what throws Prisma's "Unknown argument `emailVerified`" and surfaces as NextAuth's generic OAuthCreateAccount error.
  passwordHash   String?
  name           String?
  image          String?
  role           String   @default("USER")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subscription   Subscription?
  predictions    Prediction[]  @relation("PredictionAuthor")
  approvals      Prediction[]  @relation("PredictionApprover")
  settlements    Prediction[]  @relation("PredictionSettler")
  rewriteRequests Prediction[] @relation("PredictionRewriteRequester")
  assignedTasks  AdminTask[]   @relation("AssignedTo")
  createdTasks   AdminTask[]   @relation("CreatedBy")
  betSlips       BetSlip[]
  aiJobs         AIJob[]
  accounts       Account[]
}

// OAuth provider links (Google, etc.) — required by @auth/prisma-adapter for
// any non-Credentials provider; the Credentials provider never touches this
// table since it authenticates via passwordHash, not adapter account-linking.
// No Session model: session strategy is "jwt" (src/lib/auth.ts), so NextAuth
// never persists DB-backed sessions and the adapter's session methods are
// never called.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Subscription {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier             String    @default("FREE")
  status           String    @default("PENDING")
  paystackRef      String?
  paystackSubCode  String?
  currentPeriodEnd DateTime?
  approvedById     String?
  approvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model League {
  id        String     @id @default(cuid())
  apiId     Int        @unique
  name      String
  country   String
  logo      String?
  season    Int
  fixtures  Fixture[]
  standings Standing[]
}

model Team {
  id           String     @id @default(cuid())
  apiId        Int        @unique
  name         String
  logo         String?
  country      String?
  homeFixtures Fixture[]  @relation("HomeTeam")
  awayFixtures Fixture[]  @relation("AwayTeam")
  standings    Standing[]
}

model Fixture {
  id           String        @id @default(cuid())
  apiId        Int           @unique
  leagueId     String
  league       League        @relation(fields: [leagueId], references: [id])
  homeTeamId   String
  homeTeam     Team          @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId   String
  awayTeam     Team          @relation("AwayTeam", fields: [awayTeamId], references: [id])
  kickoff      DateTime
  status       String
  homeScore    Int?
  awayScore    Int?
  venue        String?
  predictions  Prediction[]
  betSlipItems BetSlipItem[]
  updatedAt    DateTime      @updatedAt

  @@index([kickoff])
  @@index([leagueId, kickoff])
}

model Standing {
  id           String @id @default(cuid())
  leagueId     String
  league       League @relation(fields: [leagueId], references: [id])
  teamId       String
  team         Team   @relation(fields: [teamId], references: [id])
  rank         Int
  points       Int
  played       Int
  win          Int
  draw         Int
  loss         Int
  goalsFor     Int
  goalsAgainst Int
  form         String?

  @@unique([leagueId, teamId])
}

// Team/league enrichment (crest, form, stats, standings) for the public
// team/league pages — independent of the dormant Team/League/Standing models
// above (which nothing writes to). Keyed by API-Football id, refreshed on a
// cron (src/app/api/admin/refresh-enrichment/route.ts), read-only from pages
// (src/lib/predictionScope.ts) — pages never call the football API live.
//
// `fetchedAt` is set ONLY on a successful refresh and is the sole signal a
// page checks to decide whether to render: null = no real data yet (hide the
// section), non-null = render + show "Updated {fetchedAt}". A failed refresh
// (including today's expected "Free plans do not have access..." case) only
// ever updates `lastAttemptAt`/`lastError` — it never touches `fetchedAt` or
// the data columns, so a later transient failure can't blank out
// previously-good cached data.
model TeamEnrichmentCache {
  id            String    @id @default(cuid())
  teamApiId     Int       @unique
  teamName      String? // last-known display name — debug/admin only, never used to key lookups
  leagueApiId   Int? // representative league used to fetch season-scoped stats
  season        Int?
  crestUrl      String?
  // Venue comes back inline on the same /teams lookup that yields the crest —
  // no extra call. Nullable throughout: api-football omits venue for some
  // clubs, and the team page renders nothing rather than a placeholder.
  venueName     String?
  venueCity     String?
  venueAddress  String?
  venueCapacity Int?
  form          String? // e.g. "WWDLW", from /teams/statistics
  statsJson     Json?
  lastFixtures  Json?
  // The TeamDigest half of src/lib/ai/digest.ts, written by the SAME
  // buildTeamDigest() the AI prompt is built from — one projection of
  // /teams/statistics + /injuries + /fixtures, so the model and the match page
  // can never be reading differently-derived numbers for the same team.
  //
  // Carries what statsJson deliberately does not: home/away record splits, goal
  // averages per venue, clean sheets, failed-to-score, formations, streak, and
  // the current availability list. All of it comes off the api-football calls
  // refreshTeamCache ALREADY makes — /injuries in particular was fetched and
  // discarded before this column existed — so it costs no extra quota.
  //
  // `rank`/`points` inside are always null here: standings are a league-level
  // fetch, not part of the team refresh. The match page fills them from
  // LeagueEnrichmentCache.standingsJson, which it reads anyway.
  //
  // Null on rows cached before this column; readers fall back to statsJson/
  // lastFixtures/form, which are still written alongside it.
  teamDigestJson Json?
  // Squad and coach move on a transfer-window timescale, so they carry their
  // own squadFetchedAt on a 7-day TTL. Sharing `fetchedAt` — which the 3-hourly
  // form refresh owns — would force a squad re-fetch every cycle, and make
  // "squad not fetched yet" indistinguishable from "form refresh failed".
  // Same reasoning as playersFetchedAt on LeagueEnrichmentCache.
  squadJson      Json? // SquadPlayer[] in src/lib/enrichment.ts
  coachJson      Json? // TeamCoach, or null when no current coach resolves
  squadFetchedAt DateTime?
  fetchedAt     DateTime?
  lastAttemptAt DateTime?
  lastError     String?
  updatedAt     DateTime  @updatedAt

  @@index([lastAttemptAt])
}

// `playersFetchedAt` is deliberately SEPARATE from `fetchedAt` rather than
// sharing it. `fetchedAt` means "standings/upcoming are good"; player stats
// populate on their own timeline — La Liga today has a full standings table
// and full top-scorer list but no card data at all, because cards lag goals
// early in a season. Under one flag, "cards haven't populated yet" would be
// indistinguishable from "the refresh failed". See src/lib/enrichment.ts.
model LeagueEnrichmentCache {
  id               String    @id @default(cuid())
  leagueApiId      Int       @unique
  season           Int?
  standingsJson    Json?
  upcomingJson     Json?
  topScorersJson   Json? // LeaguePlayerStat[] in src/lib/enrichment.ts
  topAssistsJson   Json?
  topCardsJson     Json?
  fetchedAt        DateTime?
  playersFetchedAt DateTime?
  lastAttemptAt    DateTime?
  lastError        String?
  updatedAt        DateTime  @updatedAt

  @@index([lastAttemptAt])
}

// Per-fixture detail (venue, city, referee, round) for the match pages at
// /predictions/match/[slug]. Same contract as the two caches above — cron is
// the only writer (src/lib/enrichment.ts), pages read it, and `fetchedAt` is
// set ONLY on a successful fetch so a later failure can't blank good data.
//
// Keyed by matchKey (src/lib/slug.ts: "{homeTeamApiId}-{awayTeamApiId}-{UTC
// day}") rather than by api-football's fixture id, because Prediction has no
// fixture id to key on — the id is what this cache goes and *finds*, then
// stores in `fixtureApiId`. Scope is only fixtures carrying real PUBLISHED
// predictions, same narrow posture as the team/league targets.
//
// Nothing about live state is stored here: score and status come from the
// livescores/fixtures feed at request time (src/components/MatchLiveStatus),
// since a cached score is a wrong score.
model FixtureDetailCache {
  id            String    @id @default(cuid())
  matchKey      String    @unique
  homeTeamApiId Int
  awayTeamApiId Int
  kickoffDay    String // "YYYY-MM-DD", UTC — the day the refresh queries api-football for
  fixtureApiId  Int? // resolved from the day's slate by matching both team ids
  detailJson    Json? // FixtureDetail in src/lib/enrichment.ts
  fetchedAt     DateTime?
  lastAttemptAt DateTime?
  lastError     String?
  updatedAt     DateTime  @updatedAt

  @@index([lastAttemptAt])
}

// Head-to-head meetings between a team pair, for /predictions/h2h/[slug].
// Same contract as the caches above — cron-only writer, pages read it,
// fetchedAt set only on a successful fetch.
//
// Cached rather than fetched live for two reasons: pages in this app never
// call the football API per-request (see the TeamEnrichmentCache note), and a
// head-to-head record is the most cacheable data here — it changes only when
// the two teams actually play each other again, which the refresh detects by
// comparing fetchedAt against the kickoffs of the pair's own predictions.
//
// Keyed by h2hPairKey ("{lowerTeamApiId}-{higherTeamApiId}", src/lib/slug.ts):
// both orderings of a pair share one record, so it's stored once. Scope is
// only pairs that have a real PUBLISHED prediction between them.
//
// An empty meetingsJson is a SUCCESSFUL answer meaning "these two have never
// met", not a failure — it sets fetchedAt like any other result, so the page
// can tell "never met" apart from "not fetched yet".
model H2HCache {
  id            String    @id @default(cuid())
  pairKey       String    @unique
  teamAApiId    Int // the lower of the two ids
  teamBApiId    Int // the higher of the two ids
  meetingsJson  Json? // H2HMeeting[] in src/lib/h2h.ts, most recent first
  fetchedAt     DateTime?
  lastAttemptAt DateTime?
  lastError     String?
  updatedAt     DateTime  @updatedAt

  @@index([lastAttemptAt])
}

// One row per (UTC day, api-football endpoint path), atomically incremented on
// every dispatched request — see src/lib/football/usage.ts. The Pro plan's
// 7,500/day ceiling is enforced against the SUM of these rows rather than an
// in-process counter: Vercel runs many short-lived instances, so a module-level
// number would under-count badly (the same reason the MIN_GAP_MS throttle in
// api-football.ts only paces one instance, not the account).
//
// `day` is a "YYYY-MM-DD" UTC string because api-football's own quota resets at
// UTC midnight — deriving it from a DateTime risks drifting into server-local
// time and resetting the budget on the wrong boundary.
model ApiUsage {
  id        String   @id @default(cuid())
  day       String // "YYYY-MM-DD", UTC
  path      String // e.g. "/fixtures", "/teams/statistics"
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([day, path])
  @@index([day])
}

model Prediction {
  id           String    @id @default(cuid())
  fixtureId    String?
  fixture      Fixture?  @relation(fields: [fixtureId], references: [id])
  category     String // primary category — kept in sync with `categories[0]` for backward compat
  categories   PredictionCategoryLink[]
  leagueApiId  Int? // API-Football league id — see src/lib/leagues.ts for the known list
  leagueName   String?
  homeTeam     String? // free-text match info — not tied to the Fixture ingestion table
  awayTeam     String?
  homeTeamApiId Int? // API-Football team id, resolved via searchTeam() in generate.ts — persisted so the enrichment refresh job (src/lib/enrichment.ts) never needs to re-guess a name→id match
  awayTeamApiId Int?
  kickoff      DateTime?
  status       String    @default("DRAFT")
  // market/pick/overUnder below are DISPLAY strings — for every marketType
  // except OTHER they're derived from the structured fields, never typed
  // directly, so auto-settlement (src/lib/markets.ts) has a fixed vocabulary
  // to work from instead of unparseable free text.
  marketType   String    @default("OTHER") // MATCH_WINNER | DOUBLE_CHANCE | OVER_UNDER | BTTS | CORRECT_SCORE | OTHER
  selection    Json? // shape depends on marketType — see src/lib/markets.ts; null for OTHER
  manualSettlementOnly Boolean @default(true) // true for OTHER (and any row predating this field) — never auto-resolved
  market       String
  pick         String
  ouLine       Float? // secondary over/under pick — present on every new prediction regardless of marketType
  ouDirection  String? // OVER | UNDER
  overUnder    String? // display string derived from ouLine/ouDirection, e.g. "Over 2.5 Goals"
  odds         Float?
  confidence   Int
  reasoning    String
  matchPreview String?
  // Structured AI output beyond the prose: { keyFactors: string[] }.
  //
  // keyFactors has been requested by the prompt since the beginning and thrown
  // away at persist time, so it exists in every past AIJob.rawOutput — see
  // scripts/backfill-analysis.ts, which populates this for existing rows at no
  // AI cost. Deliberately NOT a new prompt field: Phase 3 changes no prompt and
  // no output schema, so previously-generated predictions stay fully valid.
  //
  // Duplicated across the rows of one fixture the same way matchPreview is —
  // one AI job produces several market rows that share its analysis.
  analysisJson Json?
  contextComplete Boolean @default(true) // false = AI-generated with zero live data (all football-API context calls came back empty/failed)
  outcome      String    @default("PENDING")
  // A1 settlement: no Fixture-ingestion pipeline exists in this app (Livescores/
  // Fixtures/Standings all hit API-Football live per-request, nothing is written
  // to the Fixture table), so the finished score is looked up per-prediction and
  // stored here directly — consistent with homeTeam/awayTeam already being free
  // text rather than a Fixture relation. See src/app/api/admin/settle/route.ts.
  finalHomeScore Int?
  finalAwayScore Int?
  // settledById null + settledAt set  = auto-settled (src/app/api/admin/settle)
  // settledById set                   = manual admin override (A2)
  // settlementNote: why a PENDING row hasn't auto-settled — cleared once outcome is set
  settledById  String?
  settledBy    User?     @relation("PredictionSettler", fields: [settledById], references: [id])
  settledAt    DateTime?
  settlementNote String?
  authorId     String
  author       User      @relation("PredictionAuthor", fields: [authorId], references: [id])
  approvedById String?
  approvedBy   User?     @relation("PredictionApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  // Rewrite audit — same shape as approvedById/approvedAt and settledById/
  // settledAt: who asked for the last regeneration and when. rewriteCount is
  // denormalised so the UI can show "3 rewrites" without parsing the JSON.
  rewriteRequestedById String?
  rewriteRequestedBy   User?  @relation("PredictionRewriteRequester", fields: [rewriteRequestedById], references: [id])
  rewriteRequestedAt   DateTime?
  rewriteCount         Int    @default(0)
  // Superseded drafts, oldest first: [{ matchPreview, reasoning, market, pick,
  // confidence, odds, marketType, selection, ouLine, ouDirection, replacedAt,
  // requestedById, reviewerNote }]. A JSON column rather than a version table
  // because this is append-only, read only by the admin reviewing one row, and
  // never queried across rows — the same reasoning that put selection/statsJson
  // in Json columns. A join table would add a model and a migration for data
  // nothing filters or aggregates on.
  previousDrafts Json?
  publishedAt  DateTime?
  aiJobId      String?
  aiJob        AIJob?    @relation(fields: [aiJobId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([category, status])
  @@index([publishedAt])
}

// A prediction can be cross-posted into multiple category feeds at once
// (e.g. shown free under TODAY and also as a paid VIP exclusive).
model PredictionCategoryLink {
  id           String     @id @default(cuid())
  predictionId String
  prediction   Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  category     String

  @@unique([predictionId, category])
  @@index([category])
}

model AIJob {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  prompt      String
  model       String
  rawOutput   String
  status      String       @default("COMPLETED")
  contextComplete Boolean  @default(true) // false = every football-API context call (team search, form, standings, h2h) came back empty/failed
  // Gemini's own usageMetadata for this call. Recorded so prompt-size changes
  // are measured rather than estimated — the digest work in src/lib/ai/digest.ts
  // is justified by these two columns, and any future regression in prompt size
  // shows up here instead of on the bill. Null on jobs predating the columns,
  // and on any provider that doesn't report usage.
  promptTokens Int?
  outputTokens Int?
  // Wall-clock time for the model call, in milliseconds. Recorded alongside the
  // token counts so the generation panel can show p50/p95 latency and spot a
  // provider degrading before it starts failing outright.
  durationMs   Int?
  // The evidence passed to the model, as a versioned StoredContext (see
  // src/lib/ai/context.ts). v1 rows hold the raw api-football payloads; v2 rows
  // hold the MatchDigest actually prompted with. Persisted so a rewrite can
  // re-ask from the exact same evidence without spending API-Football quota:
  // a rewrite is a writing/judgement problem, not a stale-data problem.
  //
  // Null on jobs created before this column existed — those predictions cannot
  // be rewritten without a re-fetch, and the rewrite endpoint refuses rather
  // than silently regenerating from a weaker prompt.
  context     Json?
  // Reviewer direction for rewrites ("focus on the injury angle"); null on the
  // original generation. Kept per-job so each round's instruction is auditable.
  reviewerNote String?
  createdAt   DateTime     @default(now())
  predictions Prediction[]
}

// One row per fixture the scheduled generator has tried to produce predictions
// for. NOT a job queue: nothing is ever enqueued here in advance.
//
// Candidates are DERIVED each run from upcoming fixtures that have no Prediction
// yet (src/lib/generation/selector.ts), because Prediction rows already are the
// state — pre-enqueuing would create a second source of truth that goes stale
// the moment a fixture is postponed. What derivation alone cannot do is stop
// retrying a fixture that fails forever, and that is exactly what this table is
// for: attempts, backoff, and a terminal ABANDONED state that takes a fixture
// out of the candidate pool without burning quota on it every run.
//
// Keyed by matchKey ("{homeApiId}-{awayApiId}-{UTC day}", src/lib/slug.ts) —
// the same fixture identity FixtureDetailCache, matchSlug and
// getPublishedMatchIndex already use, so a fixture means the same thing
// everywhere. The unique constraint is also what makes concurrent or repeated
// runs idempotent: bulk generation previously had NO duplicate guard at all and
// would happily produce a second set of predictions for the same fixture.
model GenerationAttempt {
  id            String    @id @default(cuid())
  matchKey      String    @unique
  fixtureApiId  Int?
  leagueApiId   Int?
  homeTeam      String
  awayTeam      String
  kickoff       DateTime
  // PENDING | SUCCEEDED | FAILED | ABANDONED
  // FAILED is retryable and carries nextAttemptAt; ABANDONED is the dead letter
  // — retries exhausted, visible in the admin panel, never selected again.
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  lastError     String?
  lastAttemptAt DateTime?
  // When this fixture becomes eligible again after a failure. Null on a fresh
  // or terminal row.
  nextAttemptAt DateTime?
  // Rows produced on success, for tracing a fixture to its output without
  // re-deriving the match key.
  predictionIds String[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, nextAttemptAt])
  @@index([kickoff])
}

model AppLock {
  // Cooperative lease, not a Postgres advisory lock.
  //
  // Advisory locks are session-scoped, and every connection here goes through
  // Neon's pgbouncer in transaction pooling mode. That breaks them twice over:
  // the unlock can land on a different backend than the lock did, stranding it
  // until the compute recycles, and two separate clients multiplexed onto the
  // SAME backend both acquire it re-entrantly, so it silently fails open. A
  // lease is plain rows — it does not care which backend a statement lands on.
  key        String   @id
  // Random per run, so a holder can only release its own lease.
  holder     String
  acquiredAt DateTime @default(now())
  // Past this, any run may steal the lease. Set above the platform's function
  // timeout so a killed run self-heals without anyone touching the database.
  expiresAt  DateTime

  @@index([expiresAt])
}

model AdminTask {
  id           String    @id @default(cuid())
  title        String
  description  String?
  status       String    @default("OPEN")
  dueAt        DateTime?
  createdById  String
  createdBy    User      @relation("CreatedBy", fields: [createdById], references: [id])
  assignedToId String?
  assignedTo   User?     @relation("AssignedTo", fields: [assignedToId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model BetSlip {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  name      String        @default("My slip")
  totalOdds Float         @default(1.0)
  stake     Float         @default(0)
  createdAt DateTime      @default(now())
  items     BetSlipItem[]
}

model BetSlipItem {
  id        String  @id @default(cuid())
  betSlipId String
  betSlip   BetSlip @relation(fields: [betSlipId], references: [id], onDelete: Cascade)
  fixtureId String
  fixture   Fixture @relation(fields: [fixtureId], references: [id])
  market    String
  pick      String
  odds      Float
}

// Affiliate bookmaker links surfaced on /bet-builder's "Continue to
// bookmaker" step — no booking-code integration, just a name + logo + outbound
// affiliateUrl. `active` gates which ones the public picker shows; inactive
// rows stay in the table so a placeholder can be added ahead of a real
// affiliate signup and flipped on later without re-entering it.
model Bookmaker {
  id           String   @id @default(cuid())
  name         String   @unique
  logoUrl      String?
  affiliateUrl String
  active       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Editorially curated accumulator (like WinDrawWin's daily combos) — gated as
// a whole by `category` (reuses PredictionCategory), not per leg. Feeds into
// Bet Builder's existing slip state via /bet-builder?combo=<id>.
model Combo {
  id          String     @id @default(cuid())
  title       String
  description String?
  category    String // PredictionCategory — gates the whole combo
  published   Boolean    @default(false)
  legs        ComboLeg[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([category, published])
}

// Legs are snapshotted (matchLabel/market/pick/odds) at creation time rather
// than a live relation — a combo shouldn't silently change if the source
// Prediction is later edited or re-settled. `predictionId` is kept only for
// admin traceability, not a FK, so it survives the source row being deleted.
model ComboLeg {
  id           String  @id @default(cuid())
  comboId      String
  combo        Combo   @relation(fields: [comboId], references: [id], onDelete: Cascade)
  matchLabel   String
  market       String
  pick         String
  odds         Float
  predictionId String?
  order        Int     @default(0)

  @@index([comboId])
}
