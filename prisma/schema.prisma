// Betgenius — data model
// Postgres (Neon). "Enum-like" fields are kept as plain strings rather than
// real Prisma enums; matching TypeScript union types live in src/lib/enums.ts.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// Role: "USER" | "ADMIN_PENDING" | "ADMIN" | "SUPER_ADMIN"
// SubscriptionTier: "FREE" | "VIP" | "PREMIUM"
// SubscriptionStatus: "PENDING" | "ACTIVE" | "CANCELED" | "EXPIRED"
// PredictionCategory: "FEATURED" | "GENIUS" | "TODAY" | "BANKER" | "VIP" | "PREMIUM"
// PredictionStatus: "DRAFT" | "PENDING_REVIEW" | "APPROVED" | "PUBLISHED" | "ARCHIVED"
// Outcome: "PENDING" | "WON" | "LOST" | "VOID"
// TaskStatus: "OPEN" | "IN_PROGRESS" | "DONE"

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  emailVerified  DateTime? // Required by PrismaAdapter's AdapterUser shape — every OAuth createUser() call includes it (null for a fresh sign-up), even though nothing here reads it back. Missing this column is what throws Prisma's "Unknown argument `emailVerified`" and surfaces as NextAuth's generic OAuthCreateAccount error.
  passwordHash   String?
  name           String?
  image          String?
  role           String   @default("USER")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subscription   Subscription?
  predictions    Prediction[]  @relation("PredictionAuthor")
  approvals      Prediction[]  @relation("PredictionApprover")
  settlements    Prediction[]  @relation("PredictionSettler")
  assignedTasks  AdminTask[]   @relation("AssignedTo")
  createdTasks   AdminTask[]   @relation("CreatedBy")
  betSlips       BetSlip[]
  aiJobs         AIJob[]
  accounts       Account[]
}

// OAuth provider links (Google, etc.) — required by @auth/prisma-adapter for
// any non-Credentials provider; the Credentials provider never touches this
// table since it authenticates via passwordHash, not adapter account-linking.
// No Session model: session strategy is "jwt" (src/lib/auth.ts), so NextAuth
// never persists DB-backed sessions and the adapter's session methods are
// never called.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Subscription {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier             String    @default("FREE")
  status           String    @default("PENDING")
  paystackRef      String?
  paystackSubCode  String?
  currentPeriodEnd DateTime?
  approvedById     String?
  approvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model League {
  id        String     @id @default(cuid())
  apiId     Int        @unique
  name      String
  country   String
  logo      String?
  season    Int
  fixtures  Fixture[]
  standings Standing[]
}

model Team {
  id           String     @id @default(cuid())
  apiId        Int        @unique
  name         String
  logo         String?
  country      String?
  homeFixtures Fixture[]  @relation("HomeTeam")
  awayFixtures Fixture[]  @relation("AwayTeam")
  standings    Standing[]
}

model Fixture {
  id           String        @id @default(cuid())
  apiId        Int           @unique
  leagueId     String
  league       League        @relation(fields: [leagueId], references: [id])
  homeTeamId   String
  homeTeam     Team          @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId   String
  awayTeam     Team          @relation("AwayTeam", fields: [awayTeamId], references: [id])
  kickoff      DateTime
  status       String
  homeScore    Int?
  awayScore    Int?
  venue        String?
  predictions  Prediction[]
  betSlipItems BetSlipItem[]
  updatedAt    DateTime      @updatedAt

  @@index([kickoff])
  @@index([leagueId, kickoff])
}

model Standing {
  id           String @id @default(cuid())
  leagueId     String
  league       League @relation(fields: [leagueId], references: [id])
  teamId       String
  team         Team   @relation(fields: [teamId], references: [id])
  rank         Int
  points       Int
  played       Int
  win          Int
  draw         Int
  loss         Int
  goalsFor     Int
  goalsAgainst Int
  form         String?

  @@unique([leagueId, teamId])
}

// Team/league enrichment (crest, form, stats, standings) for the public
// team/league pages — independent of the dormant Team/League/Standing models
// above (which nothing writes to). Keyed by API-Football id, refreshed on a
// cron (src/app/api/admin/refresh-enrichment/route.ts), read-only from pages
// (src/lib/predictionScope.ts) — pages never call the football API live.
//
// `fetchedAt` is set ONLY on a successful refresh and is the sole signal a
// page checks to decide whether to render: null = no real data yet (hide the
// section), non-null = render + show "Updated {fetchedAt}". A failed refresh
// (including today's expected "Free plans do not have access..." case) only
// ever updates `lastAttemptAt`/`lastError` — it never touches `fetchedAt` or
// the data columns, so a later transient failure can't blank out
// previously-good cached data.
model TeamEnrichmentCache {
  id            String    @id @default(cuid())
  teamApiId     Int       @unique
  teamName      String? // last-known display name — debug/admin only, never used to key lookups
  leagueApiId   Int? // representative league used to fetch season-scoped stats
  season        Int?
  crestUrl      String?
  form          String? // e.g. "WWDLW", from /teams/statistics
  statsJson     Json?
  lastFixtures  Json?
  fetchedAt     DateTime?
  lastAttemptAt DateTime?
  lastError     String?
  updatedAt     DateTime  @updatedAt

  @@index([lastAttemptAt])
}

model LeagueEnrichmentCache {
  id            String    @id @default(cuid())
  leagueApiId   Int       @unique
  season        Int?
  standingsJson Json?
  upcomingJson  Json?
  fetchedAt     DateTime?
  lastAttemptAt DateTime?
  lastError     String?
  updatedAt     DateTime  @updatedAt

  @@index([lastAttemptAt])
}

// One row per (UTC day, api-football endpoint path), atomically incremented on
// every dispatched request — see src/lib/football/usage.ts. The Pro plan's
// 7,500/day ceiling is enforced against the SUM of these rows rather than an
// in-process counter: Vercel runs many short-lived instances, so a module-level
// number would under-count badly (the same reason the MIN_GAP_MS throttle in
// api-football.ts only paces one instance, not the account).
//
// `day` is a "YYYY-MM-DD" UTC string because api-football's own quota resets at
// UTC midnight — deriving it from a DateTime risks drifting into server-local
// time and resetting the budget on the wrong boundary.
model ApiUsage {
  id        String   @id @default(cuid())
  day       String // "YYYY-MM-DD", UTC
  path      String // e.g. "/fixtures", "/teams/statistics"
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([day, path])
  @@index([day])
}

model Prediction {
  id           String    @id @default(cuid())
  fixtureId    String?
  fixture      Fixture?  @relation(fields: [fixtureId], references: [id])
  category     String // primary category — kept in sync with `categories[0]` for backward compat
  categories   PredictionCategoryLink[]
  leagueApiId  Int? // API-Football league id — see src/lib/leagues.ts for the known list
  leagueName   String?
  homeTeam     String? // free-text match info — not tied to the Fixture ingestion table
  awayTeam     String?
  homeTeamApiId Int? // API-Football team id, resolved via searchTeam() in generate.ts — persisted so the enrichment refresh job (src/lib/enrichment.ts) never needs to re-guess a name→id match
  awayTeamApiId Int?
  kickoff      DateTime?
  status       String    @default("DRAFT")
  // market/pick/overUnder below are DISPLAY strings — for every marketType
  // except OTHER they're derived from the structured fields, never typed
  // directly, so auto-settlement (src/lib/markets.ts) has a fixed vocabulary
  // to work from instead of unparseable free text.
  marketType   String    @default("OTHER") // MATCH_WINNER | DOUBLE_CHANCE | OVER_UNDER | BTTS | CORRECT_SCORE | OTHER
  selection    Json? // shape depends on marketType — see src/lib/markets.ts; null for OTHER
  manualSettlementOnly Boolean @default(true) // true for OTHER (and any row predating this field) — never auto-resolved
  market       String
  pick         String
  ouLine       Float? // secondary over/under pick — present on every new prediction regardless of marketType
  ouDirection  String? // OVER | UNDER
  overUnder    String? // display string derived from ouLine/ouDirection, e.g. "Over 2.5 Goals"
  odds         Float?
  confidence   Int
  reasoning    String
  matchPreview String?
  contextComplete Boolean @default(true) // false = AI-generated with zero live data (all football-API context calls came back empty/failed)
  outcome      String    @default("PENDING")
  // A1 settlement: no Fixture-ingestion pipeline exists in this app (Livescores/
  // Fixtures/Standings all hit API-Football live per-request, nothing is written
  // to the Fixture table), so the finished score is looked up per-prediction and
  // stored here directly — consistent with homeTeam/awayTeam already being free
  // text rather than a Fixture relation. See src/app/api/admin/settle/route.ts.
  finalHomeScore Int?
  finalAwayScore Int?
  // settledById null + settledAt set  = auto-settled (src/app/api/admin/settle)
  // settledById set                   = manual admin override (A2)
  // settlementNote: why a PENDING row hasn't auto-settled — cleared once outcome is set
  settledById  String?
  settledBy    User?     @relation("PredictionSettler", fields: [settledById], references: [id])
  settledAt    DateTime?
  settlementNote String?
  authorId     String
  author       User      @relation("PredictionAuthor", fields: [authorId], references: [id])
  approvedById String?
  approvedBy   User?     @relation("PredictionApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  publishedAt  DateTime?
  aiJobId      String?
  aiJob        AIJob?    @relation(fields: [aiJobId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([category, status])
  @@index([publishedAt])
}

// A prediction can be cross-posted into multiple category feeds at once
// (e.g. shown free under TODAY and also as a paid VIP exclusive).
model PredictionCategoryLink {
  id           String     @id @default(cuid())
  predictionId String
  prediction   Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  category     String

  @@unique([predictionId, category])
  @@index([category])
}

model AIJob {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  prompt      String
  model       String
  rawOutput   String
  status      String       @default("COMPLETED")
  contextComplete Boolean  @default(true) // false = every football-API context call (team search, form, standings, h2h) came back empty/failed
  createdAt   DateTime     @default(now())
  predictions Prediction[]
}

model AdminTask {
  id           String    @id @default(cuid())
  title        String
  description  String?
  status       String    @default("OPEN")
  dueAt        DateTime?
  createdById  String
  createdBy    User      @relation("CreatedBy", fields: [createdById], references: [id])
  assignedToId String?
  assignedTo   User?     @relation("AssignedTo", fields: [assignedToId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model BetSlip {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  name      String        @default("My slip")
  totalOdds Float         @default(1.0)
  stake     Float         @default(0)
  createdAt DateTime      @default(now())
  items     BetSlipItem[]
}

model BetSlipItem {
  id        String  @id @default(cuid())
  betSlipId String
  betSlip   BetSlip @relation(fields: [betSlipId], references: [id], onDelete: Cascade)
  fixtureId String
  fixture   Fixture @relation(fields: [fixtureId], references: [id])
  market    String
  pick      String
  odds      Float
}

// Affiliate bookmaker links surfaced on /bet-builder's "Continue to
// bookmaker" step — no booking-code integration, just a name + logo + outbound
// affiliateUrl. `active` gates which ones the public picker shows; inactive
// rows stay in the table so a placeholder can be added ahead of a real
// affiliate signup and flipped on later without re-entering it.
model Bookmaker {
  id           String   @id @default(cuid())
  name         String   @unique
  logoUrl      String?
  affiliateUrl String
  active       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Editorially curated accumulator (like WinDrawWin's daily combos) — gated as
// a whole by `category` (reuses PredictionCategory), not per leg. Feeds into
// Bet Builder's existing slip state via /bet-builder?combo=<id>.
model Combo {
  id          String     @id @default(cuid())
  title       String
  description String?
  category    String // PredictionCategory — gates the whole combo
  published   Boolean    @default(false)
  legs        ComboLeg[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([category, published])
}

// Legs are snapshotted (matchLabel/market/pick/odds) at creation time rather
// than a live relation — a combo shouldn't silently change if the source
// Prediction is later edited or re-settled. `predictionId` is kept only for
// admin traceability, not a FK, so it survives the source row being deleted.
model ComboLeg {
  id           String  @id @default(cuid())
  comboId      String
  combo        Combo   @relation(fields: [comboId], references: [id], onDelete: Cascade)
  matchLabel   String
  market       String
  pick         String
  odds         Float
  predictionId String?
  order        Int     @default(0)

  @@index([comboId])
}
